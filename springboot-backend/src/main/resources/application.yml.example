# ===========================================
# Configuration Template
# Copy this file to application.yml and fill in your values.
# Or use environment variables: DB_URL, DB_USERNAME, DB_PASSWORD, JWT_SECRET
# ===========================================

server:
  port: 8080

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/medicine_box
    username: your_db_username
    password: your_db_password
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect

  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB

  web:
    resources:
      static-locations: classpath:/static/,file:./qianduan/

jwt:
  secret: generate-a-256-bit-hex-string-and-paste-it-here
  expiration: 604800000

file:
  upload-dir: static/uploads/